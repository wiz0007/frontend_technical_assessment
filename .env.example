# NextAuth Configuration
# The canonical URL of your site (required by NextAuth)
NEXTAUTH_URL=http://localhost:3000

# Secret key used to encrypt session tokens / JWTs
# Generate a secure key in production (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=your-secure-random-secret-key-at-least-32-chars

# External Authentication API (DummyJSON)
NEXT_PUBLIC_API_URL=https://dummyjson.com

